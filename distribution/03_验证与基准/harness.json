  "hard_rules": [
    {
      "id": "HR-1",
      "rule": "绝不编造数字",
      "how": "未知字段返回 null",
      "why": "一个编造的\"200mm\"会让客户买错设备；一个诚实的 null 只会让客户多问一句"
    },
    {
      "id": "HR-2",
      "rule": "每个结论必须带来源",
      "how": "S1 厂商 / S2 标准 / S3 文献 / S4 经验 / S5 手册",
      "why": "没有来源的数字不该进代码"
    },
    {
      "id": "HR-3",
      "rule": "冲突数据并列保留，绝不取平均",
      "how": "conflict[] 数组，不做数值合并",
      "why": "取平均会把一个明确的矛盾变成看不见的错误"
    },
    {
      "id": "HR-4",
      "rule": "承认边界",
      "how": "液压圆锥破给料 > 350mm 必须拒绝",
      "why": "它不是粗碎机，硬算会给出误导结果"
    },
    {
      "id": "HR-5",
      "rule": "不信任自我报告",
      "how": "必须真跑门禁，不能信\"应该没问题\"",
      "why": "本会话多次出现\"工具自报成功但实际失败\""
    }
  ],
