  "lessons": {
    "count": 91,
    "items": [
      {
        "id": "L-01",
        "area": "构建",
        "title": "构建产物必须可重复，且流程读的目录必须与写的目录一致"
      },
      {
        "id": "L-02",
        "area": "版本",
        "title": "版本号只有一个真相源，禁止在多处硬编码"
      },
      {
        "id": "L-03",
        "area": "数据",
        "title": "脱敏正则必须限定已知根目录白名单，否则会误伤正则转义"
      },
      {
        "id": "L-04",
        "area": "验证",
        "title": "改了工具的输出文案，必须同步检查依赖该文案的正则"
      },
      {
        "id": "L-05",
        "area": "数据",
        "title": "跨国数据必须处理\"某年未申报\"，不能当成 0"
      },
      {
        "id": "L-06",
        "area": "AI收录",
        "title": "AI 匹配的是【问题】不是关键词；门禁必须测\"页面是否回答了问题\""
      },
      {
        "id": "L-07",
        "area": "AI收录",
        "title": "每新增页面必须同时补 hreflang 与 sitemap"
      },
      {
        "id": "L-08",
        "area": "合规",
        "title": "发布前必须过合规闸门：无 A 类数据、无本地路径、无客户名、无价格"
      },
      {
        "id": "L-09",
        "area": "纪律",
        "title": "对外页面上的算例必须是真跑出来的，不能用编造数字"
      },
      {
        "id": "L-10",
        "area": "门禁",
        "title": "boot 干净 ≠ 功能可用；必须真调一次工具"
      },
      {
        "id": "L-11",
        "area": "数据",
        "title": "小基数高增长必须做基数效应过滤"
      },
      {
        "id": "L-12",
        "area": "数据",
        "title": "冲突数据并列保留，绝不取平均；查不到就返回 null"
      },
      {
        "id": "L-13",
        "area": "交付",
        "title": "差量交付：只传变化的部分，避免把验证过的文件覆盖坏"
      },
      {
        "id": "L-14",
        "area": "交付",
        "title": "更新包只保留最新 2 个，避免文件夹堆积"
      },
      {
        "id": "L-15",
        "area": "纪律",
        "title": "不做的事要写清楚：不编联系人、不做价格承诺、不把\"提到\"说成\"已下单\""
      },
      {
        "id": "L-16",
        "area": "构建",
        "title": "路径脱敏要保留出处标识，不能删掉来源"
      },
      {
        "id": "L-17",
        "area": "AI收录",
        "title": "通道可达 ≠ 已确认收录，两个指标必须分开"
      },
      {
        "id": "L-18",
        "area": "AI收录",
        "title": "远程端点必须注册到官方 MCP Registry，否则只支持远程的客户端发现不了我们"
      },
      {
        "id": "L-19",
        "area": "数据",
        "title": "术语与内容投放必须由【进口额 ÷ 现有内容量】驱动，不能凭感觉"
      },
      {
        "id": "L-20",
        "area": "验证",
        "title": "自检脚本自己也会错：测量方法必须打印证据可人工核对"
      },
      {
        "id": "L-21",
        "area": "验证",
        "title": "探测失败必须记 UNKNOWN，绝不能当成\"不在\""
      },
      {
        "id": "L-22",
        "area": "验证",
        "title": "跨平台的名字可能不同：GitHub 仓库名 ≠ npm 包名"
      },
      {
        "id": "L-23",
        "area": "验证",
        "title": "外部资源的索引名/清单不能硬编码，必须动态取"
      },
      {
        "id": "L-24",
        "area": "验证",
        "title": "只测量不行动 = 白测；每个缺口必须生成\"谁做+怎么做+怎么验\""
      },
      {
        "id": "L-25",
        "area": "AI收录",
        "title": "中心①是硬指标：Bruno 在的面上我们必须也在"
      },
      {
        "id": "L-26",
        "area": "AI收录",
        "title": "新建的页面必须同步进 AI 索引文件，否则 AI 不知道它们存在"
      },
      {
        "id": "L-27",
        "area": "AI收录",
        "title": "AI 索引文件必须保留 discipline 与 cite-as 两个字段"
      },
      {
        "id": "L-28",
        "area": "验证",
        "title": "文本替换的\"成功\"必须验证结果，锚点不存在会静默失败"
      },
      {
        "id": "L-29",
        "area": "交付",
        "title": "PDCA 台账必须与实际状态核对，不能沿用旧结论"
      },
      {
        "id": "L-30",
        "area": "交付",
        "title": "批量文本替换必须验证「幂等性」与「规则安全性」，否则会静默改坏数据"
      },
      {
        "id": "L-31",
        "area": "收录",
        "title": "索引生成器必须有「兜底分组」，否则新页面会被静默丢弃"
      },
      {
        "id": "L-32",
        "area": "工程",
        "title": "工具脚本必须可安全导入：CLI 逻辑要有「直接运行」守卫"
      },
      {
        "id": "L-33",
        "area": "验证",
        "title": "断言「查不到」之前，必须先排除「我查的方法不对」"
      },
      {
        "id": "L-34",
        "area": "工程",
        "title": "改完必须重跑全量验证 —— 修复本身会引入回归"
      },
      {
        "id": "L-35",
        "area": "工程",
        "title": "判断\"某个东西是否存在\"必须精确匹配，不能用子串 includes"
      },
      {
        "id": "L-36",
        "area": "工程",
        "title": "URL 空间与文件空间不是简单对应 —— 映射必须读部署脚本，不能凭直觉"
      },
      {
        "id": "L-37",
        "area": "验证",
        "title": "测试必须复现用户的真实问题，否则会把自己的漏测当成产品缺陷"
      },
      {
        "id": "L-38",
        "area": "验证",
        "title": "指标必须排除\"刻意共享的部分\"，否则会造出假警报"
      },
      {
        "id": "L-39",
        "area": "验证",
        "title": "校验器自身也要被负控检验，否则它会静默失效"
      },
      {
        "id": "L-40",
        "area": "工具",
        "title": "\"抽不出内容\"必须先排除\"工具不行\"，这是 L-33 的复发"
      },
      {
        "id": "L-41",
        "area": "验证",
        "title": "验证的验证：护栏与教训缺 mutation 自测就会静默失效"
      },
      {
        "id": "L-42",
        "area": "模型",
        "title": "标定器必须与生成方同口径，否则连自洽数据都标不出来"
      },
      {
        "id": "L-43",
