 *   混成一档的后果要么过度保守（什么都走贵的），要么过度放任（把合同发给免费云）。
 */
const SENSITIVE_T3A = [
  // ── 合同/法务 ──
  '合同', '协议', '条款', '违约', '索赔', '仲裁', '诉讼', '律师', '法务',
