    const c = classify(t);
    process.stdout.write('  [' + (i + 1) + '/' + tasks.length + '] ' +
      c.level + ' ' + t.slice(0, 46).padEnd(48) + ' ');
    if (c.must_stay_local) {
      const r = await dispatchLocal(t, 700);
      if (r.ok) { console.log('🔒 本地 ' + r.ms + 'ms'); local++; }
      else { console.log('❌ 本地不可用'); failed++; }
      continue;
