/* ── V001.1：文档抽取（.docx/.pdf/.xlsx 走 Python，Node 没这些库） */
/* ⚠ 沙箱边界（实测 2026-10-26 22:52）：Node 的 spawn 用默认 stdio:'pipe'
 *   捕获子进程输出会被拦（EPERM，named pipes 不可用）。
 *   ⇒ 改成：子进程用 `stdio:'ignore'`，结果**写临时文件**，父进程再读文件。
 *   这是本机跑外部工具的唯一可行方式。
 */
import { spawnSync as _spawn } from 'node:child_process';
import { tmpdir } from 'node:os';
import { unlinkSync } from 'node:fs';

function findPython() {
  const cands = [
    process.env.ECON_PYTHON,
    'C:\\Users\\m00002\\.dsh\\dsh-runtimes\\dsh-primary-runtime\\dependencies\\python\\python.exe',
  ].filter(Boolean);
  const probe = join(tmpdir(), 'econ_py_probe_' + process.pid + '.txt');
  for (const p of cands) {
    try {
      if (existsSync(probe)) { try { unlinkSync(probe); } catch { /* */ } }
      const code = 'import sys;open(r"' + probe + '","w").write(str(sys.version_info[0]))';
      const r = _spawn(p, ['-c', code], { stdio: 'ignore', timeout: 20000 });
      if (r.status === 0 && existsSync(probe)) {
        const v = readFileSync(probe, 'utf8').trim();
        try { unlinkSync(probe); } catch { /* */ }
        if (v === '3') return p;
      }
    } catch { /* next */ }
  }
  try { if (existsSync(probe)) unlinkSync(probe); } catch { /* */ }
  return null;
}

/** 抽文档正文。返回 {ok, text, err} */
function extractDocText(file, maxLen = 20000) {
  const ext = String(file).toLowerCase().match(/\.[a-z0-9]+$/);
  const e = ext ? ext[0] : '';
  // 纯文本直接读
  if (['.txt', '.md', '.csv', '.json', '.log', '.xml'].includes(e)) {
    try { return { ok: true, text: readFileSync(file, 'utf8').slice(0, maxLen) }; }
    catch (er) { return { ok: false, err: String(er.message).slice(0, 120) }; }
  }
  // docx/pdf/xlsx 走 Python（结果经临时文件中转）
  const py = findPython();
  if (!py) {
    return { ok: false, err: '找不到 Python 3（' + e + ' 需要它来解析）' };
  }
  const script = join(HERE, 'extract_doc.py');
  if (!existsSync(script)) return { ok: false, err: '缺 tools/extract_doc.py' };
  const outFile = join(tmpdir(), 'econ_doc_' + process.pid + '_' + Date.now() + '.txt');
  try {
    const r = _spawn(py, [script, file, '--max', String(maxLen), '--out', outFile],
      { stdio: 'ignore', timeout: 120000 });
    if (r.status !== 0) {
      return { ok: false, err: '抽取器退出码 ' + r.status + '（' + e + '）' };
    }
    if (!existsSync(outFile)) return { ok: false, err: '抽取器没产出结果文件' };
    const t = readFileSync(outFile, 'utf8').trim();
    if (!t) return { ok: false, err: '抽取结果为空' };
    return { ok: true, text: t };
  } catch (er) {
    return { ok: false, err: String(er.message).slice(0, 160) };
  } finally {
    try { if (existsSync(outFile)) unlinkSync(outFile); } catch { /* */ }
  }
}

