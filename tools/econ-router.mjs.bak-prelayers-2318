/* ══ QUALITY-GUARD-V0011 ══
 * 本地 1.5B 输出的质量护栏（实测必需，见 docs/经济路由规则.md 第十一章）
 * 纯规则实现，不依赖模型 —— 因为「用模型检查模型」在 1.5B 上不可靠
 */
function checkLocalQuality(output, input) {
  const out = String(output || '');
  const inp = String(input || '');
  const issues = [];

  // A. 回声检测：输出里有多少字符来自输入
  if (inp.length > 80 && out.length > 80) {
    const chunks = [];
    const step = 20;
    for (let i = 0; i + step <= inp.length; i += step) {
      chunks.push(inp.slice(i, i + step));
    }
    const echoed = chunks.filter((c) => out.includes(c)).length;
    const ratio = chunks.length ? echoed / chunks.length : 0;
    if (ratio > 0.55) {
      issues.push('回声率 ' + Math.round(ratio * 100) + '%（在复述原文，不是作答）');
    }
  }

  // B. 退化检测
  const lines = out.split('\n').map((l) => l.trim()).filter(Boolean);
  if (!lines.length) {
    issues.push('输出为空');
  } else {
    const freq = {};
    for (const l of lines) freq[l] = (freq[l] || 0) + 1;
    const maxRep = Math.max(...Object.values(freq));
    if (maxRep >= 3) {
      const worst = Object.entries(freq).find(([, v]) => v === maxRep);
      issues.push('同一行重复 ' + maxRep + ' 次（' + String(worst[0]).slice(0, 20) + '…）');
    }
    // 只有标点/空白
    const meaningful = lines.join('').replace(/[\s\p{P}]/gu, '');
    if (meaningful.length < 10) issues.push('几乎没有实质内容');
  }

  // C. 长度检测
  if (out.trim().length < 20) {
    issues.push('输出仅 ' + out.trim().length + ' 字符，可能没答完');
  }

  return {
    ok: issues.length === 0,
    issues,
    verdict: issues.length === 0 ? '看起来正常'
      : (issues.length === 1 ? '⚠ 可能不可靠' : '⛔ 明显不可靠'),
    advice: issues.length === 0 ? ''
      : '建议：这份输出只当「线索」，不要直接当结论；重要文件改用 DeepSeek 复核。',
  };
}

async function ollamaProbe(timeoutMs = 4000) {
  const t0 = Date.now();
  try {
    const r = await fetch(OLLAMA.baseURL + '/api/tags', {
      signal: AbortSignal.timeout(timeoutMs),
    });
    if (!r.ok) return { ok: false, ms: Date.now() - t0, error: 'HTTP ' + r.status };
    const j = await r.json();
    const names = (j.models || []).map((m) => m.name);
    return {
      ok: true, ms: Date.now() - t0, models: names,
      hasTarget: names.includes(OLLAMA.model) ||
        names.some((n) => n.startsWith(OLLAMA.model.split(':')[0])),
    };
  } catch (e) {
    return {
      ok: false, ms: Date.now() - t0,
      error: String((e.cause && (e.cause.code || e.cause.message)) || e.message).slice(0, 80),
      hint: '启动服务：D:\\AI\\OllamaApp\\ollama.exe serve',
    };
  }
}

async function callOllama(prompt, maxTokens = 900, timeoutMs = null) {
  timeoutMs = Number(process.env.OLLAMA_TIMEOUT_MS || timeoutMs || 420000);
  const t0 = Date.now();
  // 冷启动（第一次加载模型可能 30-60s），故超时给足
  try {
    const r = await fetch(OLLAMA.baseURL + '/v1/chat/completions', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        model: OLLAMA.model,
        messages: [{ role: 'user', content: prompt }],
        max_tokens: maxTokens,
        temperature: 0.2,
        stream: false,
      }),
      signal: AbortSignal.timeout(timeoutMs),
    });
    const ms = Date.now() - t0;
    if (!r.ok) {
      const t = await r.text().catch(() => '');
      return { ok: false, ms, error: 'HTTP ' + r.status + ' ' + t.slice(0, 100) };
    }
    const j = await r.json();
    const text = (j.choices && j.choices[0] && j.choices[0].message &&
      j.choices[0].message.content) || '';
    return { ok: true, ms, model: OLLAMA.model, text, usage: j.usage || null };
  } catch (e) {
    return {
      ok: false, ms: Date.now() - t0,
      error: String((e.cause && (e.cause.code || e.cause.message)) || e.message).slice(0, 100),
    };
  }
}

/** 本地派活（T3a/T3b 唯一出口；失败不降级到云端，只报错） */
async function dispatchLocal(prompt, maxTokens = 900) {
  const probe = await ollamaProbe();
  if (!probe.ok) {
    return {
      ok: false, stays_local: true,
      error: 'Ollama 不可用：' + probe.error,
      hint: probe.hint,
      no_fallback_reason: '⛔ 敏感内容绝不降级到云端 —— 请启动 Ollama，或我自己处理',
    };
  }
  const r = await callOllama(prompt, maxTokens);
  return { ...r, stays_local: true, provider: 'ollama',
    providerName: OLLAMA.name };
}

/* ══════════════════════════════════════════════════════════════════════
 * ③b ★ V001.1 分块（实测必需）
 * ══════════════════════════════════════════════════════════════════════
 * 实测（2026-10-26 23:02，用真实文件）：
 *   NDA 599 字符   → ✅ 输出有用（正确找出"未约定违约责任"）
 *   维修合同 753   → ✅ 输出基本正确（4 项对 3 项）
 *   技术协议 1242  → ❌ **退化**：输出一串重复的「明确的设备…详细说明」（幻觉列表）
 *   ⇒ **1.5B 的可用上限约 800 字符**，超过就崩。
 *
 * 修法：按段落切块，每块 ≤ CHUNK_CHARS，逐块处理再合并。
 * 这比「换个更大的模型」便宜得多，也更可控。
 */
const CHUNK_CHARS = Number(process.env.OLLAMA_CHUNK_CHARS || 700);

function splitIntoChunks(text, maxChars = CHUNK_CHARS) {
  if (text.length <= maxChars) return [text];
  const paras = text.split(/\n{1,}/).filter((p) => p.trim());
  const chunks = [];
  let cur = '';
  for (const p of paras) {
    if (p.length > maxChars) {           // 单段超长 → 硬切
      if (cur) { chunks.push(cur); cur = ''; }
      for (let i = 0; i < p.length; i += maxChars) {
        chunks.push(p.slice(i, i + maxChars));
      }
      continue;
    }
    if ((cur + '\n' + p).length > maxChars) {
      if (cur) chunks.push(cur);
      cur = p;
    } else {
      cur = cur ? cur + '\n' + p : p;
    }
  }
  if (cur) chunks.push(cur);
  return chunks.filter((c) => c.trim());
}

/** 分块本地处理：长文档自动切，逐块问，最后合并 */
async function dispatchLocalChunked(instruction, docText, maxTokens = 500) {
  if (docText.length <= CHUNK_CHARS) {         // 短文档 → 一次
    const r = await dispatchLocal(
      instruction + '\n\n---\n\n' + docText, maxTokens);
    return { ...r, chunks: 1, chunked: false };
  }
  const parts = splitIntoChunks(docText, CHUNK_CHARS);
  const outs = [];
  let totalMs = 0;
  let totalTokens = 0;
  for (let i = 0; i < parts.length; i++) {
    // ★ 内容在前、指令在后（实测：指令在前会让 1.5B 复述原文而不作答）
    const sub = parts[i] + '\n\n---\n\n' + instruction;
    const r = await dispatchLocal(sub, maxTokens);
    if (!r.ok) {
      return {
        ...r, chunks: parts.length, chunked: true,
        error: `第 ${i + 1}/${parts.length} 段失败：${r.error}`,
        partial: outs,
      };
    }
    totalMs += r.ms || 0;
    totalTokens += (r.usage && r.usage.total_tokens) || 0;
    outs.push({ i: i + 1, text: r.text });
  }
  return {
    ok: true, stays_local: true, provider: 'ollama',
    providerName: OLLAMA.name + `（分 ${parts.length} 块）`,
    ms: totalMs, chunks: parts.length, chunked: true,
    text: outs.map((o) => `【第${o.i}段】\n${o.text}`).join('\n\n'),
    usage: { total_tokens: totalTokens },
  };
}

