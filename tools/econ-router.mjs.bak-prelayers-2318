  // ── 支付/财务 ──
  '付款', '支付', '账期', '应收账款', '应付账款', '发票', '开票', '税号',
  '银行', '账号', '户名', 'SWIFT', 'LC', '信用证', '定金', '尾款',
  '报价', '单价', '总价', '成本', '毛利', '折扣', '返点', '佣金',
  // ── 客户/渠道机密 ──
  '客户名单', '客户名', '联系人', '手机号', '身份证', '护照',
  '代理商名单', '经销商名单', '渠道政策',
  // ── 技术机密 ──
  '图纸', 'CAD', 'BOM', '配方', '工艺流程', '参数表', '设计文件',
  '专利', '技术秘密', 'know-how',
  // ── 投标 ──
  '招标', '投标', '标书', '评标', '中标',
  // ── 通用密级标记 ──
  '机密', '绝密', '内部资料', '不得外传', '仅限内部',
];

const SENSITIVE_T3B = [
  // ── 人事 ──
  '工资', '薪酬', '薪资', '奖金', '绩效考核', '人事', '简历', '离职',
  '招聘', '面试', '员工', '组织架构',
  // ── 内部经营 ──
  '预算', '费用', '报销', '内部流程', '管理制度', '例会纪要',
];

function isSensitive(text) {
  const t = String(text || '');
  const a = SENSITIVE_T3A.filter((w) => t.includes(w));
  if (a.length) return { level: 'T3a', hits: a, label: '绝密' };
  const b = SENSITIVE_T3B.filter((w) => t.includes(w));
  if (b.length) return { level: 'T3b', hits: b, label: '内部' };
  return { level: null, hits: [], label: '' };
}

/* ══════════════════════════════════════════════════════════════════════
 * ② 任务分级（判据可复核，不拍脑袋）
 * ══════════════════════════════════════════════════════════════════════ */
const SIGNALS = {
  code: [
    /\.(py|mjs|js|ts|tsx|jsx|go|rs|java|cpp|c|h|sh|ps1|cmd|json|yaml|yml|html|css|sql)\b/i,
    /(写|加|改|修|重构|补|删|优化)(个|一个|一下)?(函数|方法|类|脚本|文件|模块|接口|测试|参数|逻辑|bug|错误)/,
    /(实现|编写|生成)(一个|个)?(函数|脚本|程序|工具|模块)/i,
    /(fix|implement|refactor|add|write|create)\s+(a\s+)?(function|script|module|class|test|method)/i,
    /报错|异常|stack trace|Traceback|SyntaxError|TypeError/i,
  ],
  judge: [
    /(选型|评估|判断|该不该|要不要|值不值|哪个好|怎么选|取舍|权衡)/,
    /(风险|隐患|漏洞|问题在哪|为什么|原因是什么)/,
    /(方案|策略|建议|推荐|话术|谈判|定价)/,
    /(analyze|evaluate|assess|recommend|should|which is better|trade-?off)/i,
  ],
  mechanical: [
    /(整理|转换|抽取|提取|翻译|分类|归类|格式化|清洗|拆分|合并|归纳|摘要)/,
    /(翻译成|翻成|用英文|用中文|转成|变成)/,
    /(translate|extract|classify|format|summarize|convert|clean|parse)/i,
  ],
  compute: [
    /(统计|计算|求和|总数|多少个|去重|排序|筛选|平均值|最大值|最小值|占比)/,
    /(count|sum|average|dedupe|sort|filter|total|how many)/i,
  ],
};

function classify(text) {
  // ① 敏感优先（这条覆盖其他所有规则）
  const sens = isSensitive(text);
  if (sens.level === 'T3a') {
    return {
      version: VERSION, level: 'T3a', channel: 'local-ollama',
      reason: '命中绝密词：' + sens.hits.slice(0, 3).join('、'),
      action: '⛔ 绝密内容永不出网 → 本地 Ollama（qwen2.5:1.5b）处理；不可用时我自己做',
      cost: '零（本地）',
      must_stay_local: true,
    };
  }
  if (sens.level === 'T3b') {
    return {
      version: VERSION, level: 'T3b', channel: 'local-ollama',
      reason: '命中内部词：' + sens.hits.slice(0, 3).join('、'),
      action: '内部资料 → 本地 Ollama 优先；失败我自己做（不派云端）',
      cost: '零（本地）',
      must_stay_local: true,
    };
  }
  // ② 难度分级
  for (const [key, patterns] of Object.entries(SIGNALS)) {
    if (!patterns.some((re) => re.test(text))) continue;
    if (key === 'code') {
      return {
        version: VERSION, level: 'T1', channel: 'codex',
        reason: '命中编程信号',
        action: '派给 Codex（编码专用，不烧对话 token）',
        cost: 'Codex 订阅（边际成本 0）', must_stay_local: false,
      };
    }
    if (key === 'judge') {
      return {
        version: VERSION, level: 'T2', channel: 'deepseek-self',
        reason: '命中判断信号',
        action: '我做（需要取舍与责任判断，免费模型不可靠）',
        cost: '收费（DeepSeek）', must_stay_local: false,
      };
    }
    if (key === 'mechanical') {
      return {
        version: VERSION, level: 'T0', channel: 'free-cloud',
        reason: '命中机械活信号（整理/转换/抽取/翻译/分类）',
        action: '派给免费云模型（智谱 GLM-4-Flash，失败退 NVIDIA NIM）',
        cost: '免费', must_stay_local: false,
      };
    }
    if (key === 'compute') {
      return {
        version: VERSION, level: 'T0', channel: 'pure-script',
        reason: '命中纯算信号（统计/计数/去重）',
        action: '纯脚本算，连模型都不用',
        cost: '零', must_stay_local: false,
      };
    }
  }
  return {
    version: VERSION, level: 'T0', channel: 'free-cloud',
    reason: '无强信号，默认按机械活处理',
    action: '派给免费云模型', cost: '免费', must_stay_local: false,
  };
}

