async function callFree(prompt, provider, maxTokens = 800, timeoutMs = 45000) {
  const key = process.env[provider.keyEnv];
  if (!key) return { ok: false, error: '缺 ' + provider.keyEnv };
  const t0 = Date.now();
  const doCall = async (model) => {
    const r = await fetch(provider.baseURL + '/chat/completions', {
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        Authorization: 'Bearer ' + key,
      },
      body: JSON.stringify({
        model,
        messages: [{ role: 'user', content: prompt }],
        max_tokens: maxTokens,
        temperature: 0.2,
      }),
      signal: AbortSignal.timeout(timeoutMs),
    });
    if (!r.ok) {
      const t = await r.text().catch(() => '');
      throw new Error('HTTP ' + r.status + ' ' + t.slice(0, 80));
    }
    return r.json();
  };
  try {
    let j;
    try {
      j = await doCall(provider.model);
    } catch (e1) {
      if (!provider.fallbackModel) throw e1;
      j = await doCall(provider.fallbackModel);
    }
    const ms = Date.now() - t0;
    return {
      ok: true, ms, model: provider.model,
      text: (j.choices && j.choices[0] && j.choices[0].message &&
        j.choices[0].message.content) || '',
      usage: j.usage || null,
    };
  } catch (e) {
    return {
      ok: false, ms: Date.now() - t0,
      error: String((e.cause && (e.cause.code || e.cause.message)) ||
        e.message).slice(0, 80),
    };
  }
}

async function dispatchFree(prompt, maxTokens = 800) {
  const provs = availableProviders();
  // ★ V001.1：免费云没 key 时，自动降级到本地 Ollama
  //   理由：用户要求「用免费模型做普通工作」，而**本地 Ollama 本身就是免费的**。
  //   云 key 缺失不该让整个通道瘫痪 —— 本地兜底既零成本又不出网，更安全。
  if (!provs.length) {
    const oll = await ollamaProbe();
    if (oll.ok && oll.hasTarget) {
      const r = await callOllama(prompt, maxTokens, Number(process.env.OLLAMA_TIMEOUT_MS || 420000));
      if (r.ok) {
        return {
          ...r, provider: 'ollama', providerName: OLLAMA.name + '（云 key 缺失，自动兜底）',
          attempts: [{ provider: 'ollama', name: OLLAMA.name, ok: true, ms: r.ms }],
          fallback_used: true,
        };
      }
      return {
        ok: false, error: '免费云无 key，本地兜底也失败：' + r.error,
        hint: '配 key：setx ZHIPU_API_KEY "你的key"；或启动 Ollama',
        attempts: [{ provider: 'ollama', ok: false, error: r.error }],
      };
    }
    return {
      ok: false, error: '没有可用的免费通道（云 key 全缺，本地 Ollama 也不可用）',
      hint: '二选一：① setx ZHIPU_API_KEY "你的key" ② 启动 Ollama（D:\\AI\\OllamaApp\\ollama.exe serve）',
      attempts: [],
    };
  }
  const attempts = [];
  for (const p of provs) {
    const r = await callFree(prompt, p, maxTokens);
    attempts.push({ provider: p.id, name: p.name, ...r });
    if (r.ok) {
      return { ok: true, ...r, provider: p.id, providerName: p.name, attempts };
    }
  }
  // ★ 云全失败 → 再试本地兜底
  const oll = await ollamaProbe();
  if (oll.ok && oll.hasTarget) {
    const r = await callOllama(prompt, maxTokens, Number(process.env.OLLAMA_TIMEOUT_MS || 420000));
    if (r.ok) {
      return {
        ...r, provider: 'ollama',
        providerName: OLLAMA.name + '（云通道全失败，自动兜底）',
        attempts, fallback_used: true,
      };
    }
    attempts.push({ provider: 'ollama', ok: false, error: r.error });
  }
  return { ok: false, error: '所有免费通道都失败（含本地兜底）', attempts };
}

