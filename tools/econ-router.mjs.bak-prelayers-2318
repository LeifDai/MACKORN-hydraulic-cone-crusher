    if (c.channel === 'codex') { console.log('→ Codex'); codex_++; continue; }
    if (c.channel === 'deepseek-self') { console.log('→ 我自己'); self_++; continue; }
    if (c.channel === 'pure-script') { console.log('→ 脚本'); self_++; continue; }
    const r = await dispatchFree(t, 600);
    if (r.ok) { console.log('✅ ' + r.ms + 'ms'); free++; }
    else { console.log('❌ ' + (r.error || '').slice(0, 26)); failed++; }
