  name: 'Ollama 本地（数据不出本机）',
  baseURL: process.env.OLLAMA_BASE || 'http://127.0.0.1:11434',
  model: process.env.OLLAMA_MODEL || 'qwen2.5:1.5b',
  fallbackModel: 'qwen2.5:1.5b',
