/* ══════════════════════════════════════════════════════════════════════
 * ⑥ 成本模型（用于算「省了多少钱」）
 * ══════════════════════════════════════════════════════════════════════
 * DeepSeek 官方价（2026-10 参考，元/百万 token）：
 *   输入 ¥1.0 / 输出 ¥2.0（cache miss）；cache hit 输入 ¥0.1
 * 保守按 ¥1.5/M 混合价估算（输入输出大致 3:1）。
 * 这个单价只在「算省了多少钱」时用，不影响路由决策。
 */
const DEEPSEEK_CNY_PER_M = 1.5;

function estCostCny(tokens) {
  return ((tokens || 0) / 1e6) * DEEPSEEK_CNY_PER_M;
}

