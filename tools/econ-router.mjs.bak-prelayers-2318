function logUsage(entry) {
  try {
    mkdirSync(DATA_DIR, { recursive: true });
    appendFileSync(LEDGER,
      JSON.stringify({ at: new Date().toISOString(), v: VERSION, ...entry }) + '\n',
      'utf8');
  } catch { /* 落盘失败不影响主流程 */ }
}

function readLedger() {
  if (!existsSync(LEDGER)) return [];
  try {
    return readFileSync(LEDGER, 'utf8').split('\n').filter(Boolean)
      .map((l) => { try { return JSON.parse(l); } catch { return null; } })
      .filter(Boolean);
  } catch { return []; }
}

function buildReport() {
  const rows = readLedger();
  const byChannel = {};
  const byLevel = {};
  let totalTokens = 0;
  let freeTasks = 0;
  let paidTasks = 0;
  let localTasks = 0;
  let savedTokens = 0;

  for (const r of rows) {
    const ch = r.channel || '?';
    byChannel[ch] = (byChannel[ch] || 0) + 1;
    const lv = r.level || '?';
    byLevel[lv] = (byLevel[lv] || 0) + 1;
    const tk = Number(r.tokens) || 0;
    if (r.cost === 'free' || r.cost === 'zero' || ch === 'ollama') {
      totalTokens += tk;
      savedTokens += tk;                 // 这些 token 若走 DeepSeek 就要花钱
      freeTasks++;
      if (ch === 'ollama') localTasks++;
    } else {
      paidTasks++;
    }
  }
  const total = rows.length;
  return {
    schema: 'mackorn-econ/2',
    version: VERSION,
    at: new Date().toISOString(),
    total_tasks: total,
    by_channel: byChannel,
    by_level: byLevel,
    free_tasks: freeTasks,
    paid_tasks: paidTasks,
    local_tasks: localTasks,
    free_ratio: total ? Math.round((freeTasks / total) * 100) : 0,
    local_ratio: total ? Math.round((localTasks / total) * 100) : 0,
    tokens_routed_away: totalTokens,
    saved_cny_est: Number(estCostCny(savedTokens).toFixed(4)),
    note: 'free_ratio/free_tasks 含「本地 Ollama」与「纯脚本」；'
      + 'saved_cny_est 按 DeepSeek ¥1.5/M token 估算，仅供参考。'
      + 'DSH 会话本身的 token 不计入。',
  };
}

