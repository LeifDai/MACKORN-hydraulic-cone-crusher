  "experience": {
    "success": [
      {
        "id": "E-SUCCESS-001",
        "title": "官方 MCP Registry 靠 server.json 就能进",
        "detail": "只要仓库根有 server.json，且满足 reverse-DNS name + packages + version 一致 + description 四项，官方注册表就能收录。我们 5/5 全满足，无需人工提交。",
        "date": "2026-10-19",
        "transferable": true
      },
      {
        "id": "E-SUCCESS-002",
        "title": "Smithery 自动抓 npm + GitHub",
        "detail": "只要 npm 包能 npx 启动 stdio，且 package.json 有 description，Smithery 自动收录。加 smithery.yaml 声明无需配置能提升 UI 展示。",
        "date": "2026-10-19",
        "transferable": true
      },
      {
        "id": "E-SUCCESS-003",
        "title": "skills.sh 靠 SKILL.md frontmatter",
        "detail": "每个 skills/*/SKILL.md 必须有 frontmatter 含 name + description，然后 npx skills add 就自动收录。6 个技能全部达标。",
        "date": "2026-10-19",
        "transferable": true
      },
      {
        "id": "E-SUCCESS-004",
        "title": "awesome 列表靠 PR，但可能卡在第三方评分",
        "detail": "punkpeye/awesome-mcp-servers 要求 Glama 评分出结果才合并。所以提交 PR 不够，还要保证 Glama 能探测到我们。这是「间接依赖」—— 提交前要先确保第三方评分平台能访问我们。",
        "date": "2026-10-21",
        "transferable": true
      },
      {
        "id": "E-SUCCESS-005",
        "title": "GitHub topics 是自动抓取平台的开关",
        "detail": "mcp.so / PulseMCP / MCPServers.org 都依赖 GitHub topic（mcp-server / model-context-protocol）。设了 topic 才能被爬到。2026-10-21 设了 20 个。",
        "date": "2026-10-21",
        "transferable": true
      },
      {
        "id": "E-SUCCESS-006",
        "title": "AGENTS.md 是 AI 代理的最强信号",
        "detail": "仓库根目录 AGENTS.md 会被 Claude Code 等 AI 编程代理自动加载。内容要含：触发条件 / 调用方式 / 输出规则 / 禁止事项。比靠工具描述匹配可靠得多。",
        "date": "2026-10-21",
        "transferable": true
      },
      {
        "id": "E-SUCCESS-007",
        "title": "DNS 裸域 A 记录会自己恢复（等 1-2 小时）",
        "detail": "2026-10-21 白天 mackorn.cn 裸域返回 ENOTFOUND（A 记录缺失），当晚 23:00 再测已经恢复为 47.110.80.123。可能原因：阿里云 DNS 记录本来就存在但缓存未刷新、或 TTL 到期后重新解析。教训：DNS 问题先等 1-2 小时再判死，不要立刻下结论说\"记录丢了\"。",
        "date": "2026-10-21",
        "transferable": true
      }
    ],
    "failure": [
      {
        "id": "E-FAIL-001",
        "title": "把 SSL 证书当成唯一根因，连判 3 天",
        "detail": "从 10-19 到 10-21 连续说「SSL 证书过期」，实际是【DNS 裸域无 A 记录 + SSL 过期】两个独立问题叠加。因为只跑 fetch 看到 CERT_HAS_EXPIRED 就下结论，没把 dns.lookup 分开跑。",
        "date": "2026-10-21",
        "lesson": "诊断网络问题必须【分开测 DNS 与 TLS】，错误码不同代表不同问题。ENOTFOUND ≠ CERT_HAS_EXPIRED",
        "recurrence": 1
      },
      {
        "id": "E-FAIL-002",
        "title": "以为「提交到 20 个平台」是主要矛盾",
        "detail": "实测 18 平台后发现已收录 6 个（含官方注册表和 Glama），真正未收录只有 4 个。主要矛盾不是「没提交」，是「自有域名打不开导致已收录平台也判定我们死了」。",
        "date": "2026-10-21",
        "lesson": "先测量再行动。『让 AI 收录我们』的第一步不是提交，是【查清现状】",
        "recurrence": 1
      },
